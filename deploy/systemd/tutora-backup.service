# Daily backup (DB dump + storage archive, 14-day retention) followed by the mandatory restore
# test of the new backup. A failure of either step fails the unit; hook alerting in via
# OnFailure= (e.g. a mail unit) in a drop-in.
[Unit]
Description=Tutora backup and restore test
After=mariadb.service

[Service]
Type=oneshot
User=tutora-backup
Group=tutora-backup
EnvironmentFile=/etc/tutora/backup.env
ExecStart=/var/www/tutora/deploy/backup/tutora-backup.sh
ExecStart=/var/www/tutora/deploy/backup/tutora-restore-test.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# backups, and the GnuPG home used to decrypt for the restore test (if backups are encrypted)
ReadWritePaths=/var/backups/tutora -/var/lib/tutora-backup
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
