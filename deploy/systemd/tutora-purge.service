# Maintenance: ends sessions live > SESSION_MAX_LIVE_HOURS (default 24), then retention purge:
# expired session data (DB rows, snapshot files, whiteboard documents, slide
# images no session uses any more), expired pending signups, stale rate-limit rows.
[Unit]
Description=Tutora retention purge
After=mariadb.service

[Service]
Type=oneshot
User=tutora
Group=tutora
WorkingDirectory=/var/www/tutora/app
ExecStart=/usr/bin/php8.3 bin/purge.php
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tutora
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
