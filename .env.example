# Copy to .env (mode 640, owned by the service user). Never commit real values.
# Generate keys with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'

APP_ENV=development
APP_BASE_URL=http://localhost:8080
# Comma-separated list of allowed browser origins (WebSocket Origin check, CORS)
ALLOWED_ORIGINS=http://localhost:8080

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=tutora
DB_USER=tutora
DB_PASSWORD=change-me

# HMAC keys (hex, 32 bytes). Separate key per audience so that a verifier
# for one audience (e.g. the whiteboard sidecar) cannot mint tokens for another.
RELAY_TOKEN_KEY=
WHITEBOARD_TOKEN_KEY=
PARTICIPANT_CREDENTIAL_KEY=
# Encrypts tutor TOTP secrets at rest (libsodium secretbox)
TOTP_ENCRYPTION_KEY=

# Internal PHP -> relay broadcast (private network only). Leave RELAY_INTERNAL_URL empty
# to run without the relay (clients fall back to polling). Secret: >= 32 characters.
RELAY_INTERNAL_URL=http://relay:8081
RELAY_INTERNAL_SECRET=

# Whiteboard sidecar (Node/Yjs). Internal URL/secret for moderation calls from PHP;
# leave WHITEBOARD_INTERNAL_URL empty to run without collaborative boards.
WHITEBOARD_INTERNAL_URL=http://whiteboard:8082
WHITEBOARD_INTERNAL_SECRET=
# Public WebSocket URL of the sidecar (default: APP_BASE_URL with ws(s):// and path /wb)
WHITEBOARD_URL=

# Public WebSocket URL of the relay as seen by browsers. Default: APP_BASE_URL with
# ws(s):// and path /ws (Apache reverse-proxies /ws to the relay in production).
# Dev without Apache: ws://localhost:8090/ws
REALTIME_URL=

# Outbound mail (signup verification). SMTP submission with mandatory STARTTLS; the client
# refuses servers that do not offer STARTTLS and verifies the certificate.
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org
SMTP_FROM_NAME=Tutora
# optional: EHLO name (default: host of APP_BASE_URL), CA bundle for a private CA, timeout (s)
SMTP_HELO=
SMTP_CAFILE=
SMTP_TIMEOUT=15
# Development only: MAIL_DRIVER=file writes mails to STORAGE_PATH/mail-outbox (refused in production)

# Breached-password check (HIBP k-anonymity range API).
# false = fail closed: signup/password change is refused while HIBP is unreachable.
HIBP_FAIL_OPEN=false

# Default retention of ended-session data in days (per-tenant override in DB)
RETENTION_DAYS_DEFAULT=30

# Storage paths (must NOT be under the web root)
STORAGE_PATH=/var/lib/tutora
# Max slide deck upload (bytes); keep php.ini upload_max_filesize/post_max_size above it
UPLOAD_MAX_BYTES=52428800

# Slide conversion daemon (bin/conversion-daemon.php), one sandboxed container per job
CONVERTER_IMAGE=tutora-converter:latest
CONVERTER_RUNTIME=docker
# numeric non-root uid:gid inside the container
CONVERTER_USER=65532:65532
CONVERTER_TIMEOUT=120
CONVERTER_MAX_PAGES=300
CONVERTER_MEMORY=1g
CONVERTER_CPUS=1
CONVERTER_PIDS_LIMIT=256
# optional: custom seccomp JSON profile path / AppArmor profile name (default seccomp applies otherwise)
CONVERTER_SECCOMP_PROFILE=
CONVERTER_APPARMOR_PROFILE=

# AI (Write) summaries — disabled unless a provider is set (owner decision 6: only a provider
# with a DPA and an EU endpoint or SCCs). "stub" = offline test provider, refused in production.
AI_PROVIDER=
# Tenant quota per calendar month (UTC) and the separate hard per-session daily call cap
AI_QUOTA_CALLS_PER_MONTH=200
AI_QUOTA_TOKENS_PER_MONTH=500000
AI_CALLS_PER_SESSION_PER_DAY=10
# Upper bound of response text sent in one request (characters)
AI_MAX_INPUT_CHARS=60000
