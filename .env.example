# Copy to .env (mode 640, owned by the service user). Never commit real values.
# Generate keys with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'

APP_ENV=development
APP_BASE_URL=http://localhost:8080
# Comma-separated list of allowed browser origins (WebSocket Origin check, CORS)
ALLOWED_ORIGINS=http://localhost:8080

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=tutora
DB_USER=tutora
DB_PASSWORD=change-me

# HMAC keys (hex, 32 bytes). Separate key per audience so that a verifier
# for one audience (e.g. the whiteboard sidecar) cannot mint tokens for another.
RELAY_TOKEN_KEY=
WHITEBOARD_TOKEN_KEY=
PARTICIPANT_CREDENTIAL_KEY=
# Encrypts tutor TOTP secrets at rest (libsodium secretbox)
TOTP_ENCRYPTION_KEY=

# Internal PHP -> relay broadcast (private network only)
RELAY_INTERNAL_URL=http://relay:8081
RELAY_INTERNAL_SECRET=

# Breached-password check (HIBP k-anonymity range API).
# false = fail closed: signup/password change is refused while HIBP is unreachable.
HIBP_FAIL_OPEN=false

# Default retention of ended-session data in days (per-tenant override in DB)
RETENTION_DAYS_DEFAULT=30

# Storage paths (must NOT be under the web root)
STORAGE_PATH=/var/lib/tutora
